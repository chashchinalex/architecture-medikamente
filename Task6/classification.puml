@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_TOP_DOWN()


Person(ops, "Операционные системы", "EMR, 1С, CRM, Лаборатория, мобильное приложение")
Person(bi, "BI / Аналитики / Data Scientists", "Доступ к агрегированным данным и витринам")

System_Boundary(dwh, "Платформа данных «Медикаменте»") {


  Container(etl, "ETL / Оркестратор", "Airflow / аналог", "Оркестрация batch-загрузки данных из источников в DWH")
  Container(raw, "Raw / Staging Zone", "Хранилище (DWH/DFS)", "Сырые данные из источников, без использования для аналитики")
  Container(prof, "Data Profiler", "Сервис профилирования", "Анализ схем, типов и распределений значений\nвыявление структурных изменений")
  Container(classif, "Classification Engine", "Сервис классификации данных", "Автоматическая классификация колонок по уровням C1–C4\n(PII, медицинские данные, служебные, некритичные)")
  Container(policy, "Policy & Privacy Engine", "Сервис политик конфиденциальности", "Хранение и применение правил Privacy by Design:\nшифрование, маскирование, псевдонимизация, маршрутизация по зонам DWH")
  Container(meta, "Metadata Catalog", "Каталог метаданных", "Схемы, теги конфиденциальности, lineage,\nистория изменений классификации")
  Container(vault, "Sensitive Vault (C3/C4)", "Секьюрная зона DWH", "Изолированное зашифрованное хранилище\nдля чувствительных и особо чувствительных данных (C3/C4)")
  Container(deid, "De-Identified Zone", "Зона деперсонализированных данных", "Псевдонимизированные / деперсонализированные данные\nосновной источник для аналитики и ML")
  Container(analytics, "Analytics / Data Marts", "Витрины данных", "Агрегированные витрины и отчётные модели\nпреимущественно C1/C2, иногда маскированные C3")
}
Rel(ops, etl, "Пакетные выгрузки данных", "SFTP / API / DB dumps (TLS)")
Rel(etl, raw, "Загружает сырые данные", "Batch load")
Rel(raw, prof, "Читает наборы данных для профилирования", "Internal secure access")
Rel(prof, classif, "Передаёт профиль колонок и таблиц", "gRPC/HTTPs")
Rel(classif, policy, "Запрашивает и применяет политики\nпо классам конфиденциальности", "gRPC/HTTPs")
Rel(classif, meta, "Записывает теги и результаты классификации", "HTTPs")
Rel(policy, etl, "Возвращает правила маршрутизации:\nкакие поля шифровать, маскировать, деперсонализировать,\nв какие зоны DWH выгружать", "HTTPs")
Rel(etl, vault, "Записывает C3/C4 данные\n(PII, медицинская информация)", "Batch load (шифрование at rest)")
Rel(etl, deid, "Записывает псевдонимизированные данные\nбез прямых идентификаторов", "Batch load")
Rel(etl, analytics, "Формирует витрины и агрегаты\nна основе De-Identified Zone", "Batch load")
Rel(meta, bi, "Предоставляет метаданные,\nклассы конфиденциальности, линейку данных", "HTTPs (read-only)")
Rel(bi, analytics, "Выполняет аналитические запросы и строит отчёты", "SQL / BI-инструменты")

@enduml
